# Firebase Authentication is optional for local practice.
# Create a Firebase project, enable Google as a sign-in provider,
# register a web app, and copy its public web configuration here.
# These values identify the Firebase web app; never put service-account
# credentials or private keys in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
